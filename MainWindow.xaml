<Window
    x:Class="MuhabbetKusu.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MuhabbetKusu"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="Muhabbet Kuşu">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

                <Pivot Grid.Row="0" x:Name="ModelSelector" SelectedIndex="0" Height="48"
                       Margin="-12,0,0,20" SelectionChanged="ModelSelector_SelectionChanged">
                    <Pivot.Resources>
                        <Style TargetType="PivotHeaderItem">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="12,8,12,0"/>
                        </Style>
                    </Pivot.Resources>
                    <PivotItem Header="EMA Lightning"/>
                    <PivotItem Header="Antalia-2 Mini"/>
                </Pivot>

        <!-- Main Body: Two Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="900"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Studio / Controls -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact native Pivot headers, without a separate selection card. -->

                <!-- Row 1: Text Input Card (Fills Available Height) -->
                    <Grid Grid.Row="0" RowDefinitions="*,Auto" RowSpacing="8">
                        <TextBox Grid.Row="0" x:Name="InputTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalAlignment="Stretch" MinHeight="100" Margin="0" CornerRadius="8"
                                 PlaceholderText="Seslendirmek istediğiniz Türkçe metni buraya yazın…"
                                 Text="Merhaba, Muhabbet Kuşu çalışıyor. Bu ses tamamen bilgisayarınızda üretildi."
                                 TextChanged="InputTextBox_TextChanged">
                            <TextBox.Resources>
                                <Thickness x:Key="TextBoxTopHeaderMargin">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EstimatedSizeText" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="CharCountText" Text="72 Karakter"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                <!-- Row 2: Parameter Settings Card (Docked to Bottom) -->
                <Border Grid.Row="1" Height="116"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="CommonParametersPanel" Grid.Column="0" Grid.ColumnSpan="2" RowSpacing="10" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="54"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="4" Text="Sentez Parametreleri" FontWeight="SemiBold" FontSize="15"/>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="Hız" FontSize="12"/>
                                <NumberBox x:Name="SpeedBox" Value="1.00" SmallChange="0.05"
                                           Minimum="0.25" Maximum="4.00" HorizontalAlignment="Stretch"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Örnekleme (Hz)" FontSize="12"/>
                                <ComboBox x:Name="SampleRateBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="48000 Hz"/>
                                    <ComboBoxItem Content="24000 Hz"/>
                                    <ComboBoxItem Content="16000 Hz"/>
                                    <ComboBoxItem Content="8000 Hz"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                <TextBlock Text="Seed" FontSize="12"/>
                                <CheckBox x:Name="FixedSeedCheckBox" Content="Sabit seed" Height="32" HorizontalAlignment="Stretch"
                                          Checked="FixedSeedCheckBox_CheckedChanged"
                                          Unchecked="FixedSeedCheckBox_CheckedChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Spacing="4">
                                <TextBlock Text="Seed değeri" FontSize="12"/>
                                <NumberBox x:Name="SeedBox" Value="0" Minimum="0" Maximum="2147483647"
                                           HorizontalAlignment="Stretch" IsEnabled="False"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="AntaliaSettingsPanel" Grid.Column="1" HorizontalAlignment="Stretch"
                              Visibility="Collapsed" RowSpacing="10" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="54"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3" Text="Antalia Özel Ayarları" FontWeight="SemiBold" FontSize="15"/>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="Adım" FontSize="12"/>
                                <ComboBox x:Name="StepsBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="1"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="CFG" FontSize="12"/>
                                <NumberBox x:Name="CfgBox" Value="2.0" SmallChange="0.1"
                                           Minimum="0.5" Maximum="10.0" HorizontalAlignment="Stretch"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                <TextBlock Text="EQ ton filtresi" FontSize="12"/>
                                <ToggleSwitch x:Name="EqToggle" MinWidth="0" Height="32" HorizontalAlignment="Stretch"
                                              IsOn="True" OnContent="" OffContent=""/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="Muhabbet Kuşu başlatılıyor…" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid Grid.Column="1" x:Name="ProgressPanel" Visibility="Collapsed" ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="SynthesisProgressBar" Minimum="0" Maximum="100" Value="0"
                                             Height="8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="%0" FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button x:Name="GenerateButton" Content="▶  Ses Oluştur" Style="{ThemeResource AccentButtonStyle}"
                                    FontWeight="SemiBold" Padding="16,8" Click="GenerateButton_Click"/>
                            <Button x:Name="SaveMp3Button" Content="MP3'e Dönüştür" IsEnabled="False" Padding="12,8" Click="SaveMp3Button_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: Outputs History Gallery -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Galeri" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="RefreshGalleryButton" Width="32" Height="32" Padding="0"
                                Click="RefreshGalleryButton_Click" ToolTipService.ToolTip="Yenile" AutomationProperties.Name="Yenile">
                            <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        </Button>
                        <Button Grid.Column="3" x:Name="DeleteGalleryButton" Width="32" Height="32" Padding="0"
                                IsEnabled="False" Click="DeleteGalleryButton_Click" ToolTipService.ToolTip="Seçili sesi sil"
                                AutomationProperties.Name="Seçili sesi sil">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        </Button>
                        <Button Grid.Column="2" x:Name="OpenFolderButton" Width="32" Height="32" Padding="0"
                                Click="OpenFolderButton_Click" ToolTipService.ToolTip="Klasörü aç" AutomationProperties.Name="Klasörü aç">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                        </Button>
                    </Grid>

                    <ListView x:Name="GalleryListView" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="GalleryListView_SelectionChanged"
                              DoubleTapped="GalleryListView_DoubleTapped"
                              KeyDown="GalleryListView_KeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GalleryItem">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DateFormatted}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                            <Grid Grid.Row="2" x:Name="AudioPlayer" Margin="0,12,0,0" VerticalAlignment="Center" ColumnSpacing="8"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlaybackButton" IsEnabled="False" Click="PlaybackButton_Click" Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        AutomationProperties.Name="Oynat" ToolTipService.ToolTip="Oynat">
                                    <FontIcon x:Name="PlaybackIcon" Glyph="&#xE768;" FontSize="16"/>
                                </Button>
                                <Slider Grid.Column="1" x:Name="PlaybackSlider" Minimum="0" Maximum="1" Value="0"
                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                        ValueChanged="PlaybackSlider_ValueChanged" AutomationProperties.Name="Ses konumu"/>
                                <TextBlock Grid.Column="2" x:Name="PlaybackTime" Text="0:00 / 0:00"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <primitives:ToggleButton Grid.Column="3" Click="MuteButton_Click" Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                              AutomationProperties.Name="Sesi kapat" ToolTipService.ToolTip="Sesi kapat">
                                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16"/>
                                </primitives:ToggleButton>
                            </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
