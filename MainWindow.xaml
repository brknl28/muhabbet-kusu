<Window
    x:Class="MuhabbetKusu.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MuhabbetKusu"
    Title="Muhabbet Kuşu">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Muhabbet Kuşu" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="EMA Lightning ve Antalia-2 Mini ile yerel Türkçe metinden sese" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Main Body: Two Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Studio / Controls -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact native Pivot headers, without a separate selection card. -->
                <Pivot Grid.Row="0" x:Name="ModelSelector" SelectedIndex="0" Height="48"
                       Margin="-12,0,0,0" SelectionChanged="ModelSelector_SelectionChanged">
                    <Pivot.Resources>
                        <Style TargetType="PivotHeaderItem">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="12,8,12,0"/>
                        </Style>
                    </Pivot.Resources>
                    <PivotItem Header="EMA Lightning"/>
                    <PivotItem Header="Antalia-2 Mini"/>
                </Pivot>
                <!-- Row 1: Text Input Card (Fills Available Height) -->
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="Seslendirilecek Metin" FontWeight="SemiBold" FontSize="15"/>
                        <TextBox Grid.Row="1" x:Name="InputTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalAlignment="Stretch" MinHeight="100"
                                 PlaceholderText="Seslendirmek istediğiniz Türkçe metni buraya yazın…"
                                 Text="Merhaba, Muhabbet Kuşu çalışıyor. Bu ses tamamen bilgisayarınızda üretildi."
                                 TextChanged="InputTextBox_TextChanged"/>
                        <TextBlock Grid.Row="2" x:Name="CharCountText" Text="72 karakter"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Row 2: Parameter Settings Card (Docked to Bottom) -->
                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" RowSpacing="10" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="Sentez Parametreleri" FontWeight="SemiBold" FontSize="15"/>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="Hız (Speed)" FontSize="12"/>
                                <NumberBox x:Name="SpeedBox" Value="1.00" SmallChange="0.05"
                                           Minimum="0.25" Maximum="4.00" HorizontalAlignment="Stretch"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Örnekleme (Hz)" FontSize="12"/>
                                <ComboBox x:Name="SampleRateBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="48000 Hz"/>
                                    <ComboBoxItem Content="24000 Hz"/>
                                    <ComboBoxItem Content="16000 Hz"/>
                                    <ComboBoxItem Content="8000 Hz"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Grid.Row="2" x:Name="FixedSeedCheckBox" Content="Sabit Seed" VerticalAlignment="Bottom"
                                      Checked="FixedSeedCheckBox_CheckedChanged"
                                      Unchecked="FixedSeedCheckBox_CheckedChanged"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Seed Değeri" FontSize="12"/>
                                <NumberBox x:Name="SeedBox" Value="0" Minimum="0" Maximum="2147483647"
                                           HorizontalAlignment="Stretch" IsEnabled="False"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="AntaliaSettingsPanel" Grid.Column="1" Width="220"
                              Visibility="Collapsed" RowSpacing="10" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="Antalia Özel Ayarları" FontWeight="SemiBold" FontSize="15"/>
                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Text="Adım (Steps)" FontSize="12"/>
                                <ComboBox x:Name="StepsBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="1"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="CFG Değeri" FontSize="12"/>
                                <NumberBox x:Name="CfgBox" Value="2.0" SmallChange="0.1"
                                           Minimum="0.5" Maximum="10.0" HorizontalAlignment="Stretch"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Row="2" Grid.ColumnSpan="2" x:Name="EqToggle" Header="EQ Ton Filtresi"
                                          IsOn="True" OnContent="Aktif" OffContent="Kapalı"/>
                        </Grid>
                    </Grid>
                </Border>
                <!-- Row 3: Action Buttons Card (At the Very Bottom) -->
                <Border Grid.Row="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="GenerateButton" Content="▶  Sesi Oluştur"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    FontWeight="SemiBold" Padding="16,8"
                                    Click="GenerateButton_Click"/>
                            <Button x:Name="PlayButton" Content="Oynat" IsEnabled="False" Padding="14,8"
                                    Click="PlayButton_Click"/>
                            <Button x:Name="StopButton" Content="Durdur" IsEnabled="False" Padding="14,8"
                                    Click="StopButton_Click"/>
                            <Button x:Name="SaveWavButton" Content="WAV Kaydet…" IsEnabled="False" Padding="12,8"
                                    Click="SaveWavButton_Click"/>
                            <Button x:Name="SaveMp3Button" Content="MP3 Kaydet…" IsEnabled="False" Padding="12,8"
                                    Click="SaveMp3Button_Click"/>
                        </StackPanel>

                        <!-- Live Percentage Progress Bar (Hides when complete) -->
                        <Grid x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="SynthesisProgressBar" Grid.Column="0"
                                         Minimum="0" Maximum="100" Value="0" Height="8"
                                         VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProgressPercentText" Grid.Column="1"
                                       Text="%0" FontSize="12" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Status & Output Summary -->
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="StatusText" Text="Muhabbet Kuşu başlatılıyor…"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="ResultText" Text="Henüz ses oluşturulmadı."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Column: Outputs History Gallery -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Üretilen Sesler Galerisi (outputs/)"
                               FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                    <ListView x:Name="GalleryListView" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="GalleryListView_SelectionChanged"
                              DoubleTapped="GalleryListView_DoubleTapped"
                              KeyDown="GalleryListView_KeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GalleryItem">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind DateFormatted}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button x:Name="PlayGalleryButton" Content="▶ Seçileni Oynat" IsEnabled="False"
                                Click="PlayGalleryButton_Click"/>
                        <Button x:Name="RefreshGalleryButton" Content="🔄 Yenile"
                                Click="RefreshGalleryButton_Click"/>
                        <Button x:Name="OpenFolderButton" Content="📁 Klasörü Aç"
                                Click="OpenFolderButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
